        final p = math.sin(_entryAnimCtrl.value * math.pi).clamp(0.0, 1.0).toDouble();
        if (entryPremium) {
          return Opacity(
            opacity: p,
            child: Container(
              padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 14),
              decoration: BoxDecoration(
                gradient: LinearGradient(colors: [...cols, Colors.black87]),
                borderRadius: BorderRadius.circular(24),
                border: Border.all(color: Colors.white, width: 2.4),
                boxShadow: [
                  BoxShadow(
                    color: cols.first.withOpacity(0.85),
                    blurRadius: 14 + 22 * p,
                    spreadRadius: 2,
                  ),
                ],
              ),
              child: Row(
                children: [
                  const Text('👑', style: TextStyle(fontSize: 30)),
                  const SizedBox(width: 8),
                  Expanded(
