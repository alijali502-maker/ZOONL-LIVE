  Future<void> _loadAll() async {
    if (_uid == null) {
      if (!mounted) return;
      setState(() {
        loading = false;
        loadError = 'Login nahi hai. Pehle login karein.';
        sbStatus = 'Not logged in';
      });
      return;
    }

    if (mounted) {
      setState(() {
        loading = true;
        sbStatus = 'Loading...';
      });
    }

    final errors = <String>[];

    Future<void> step(String label, Future<void> Function() fn) async {
      try {
        await fn();
      } catch (e) {
        errors.add('$label: ${_mapErr(e)}');
      }
    }

    await step('profile', _loadProfile);
    await step('levels', _loadLevels);
    await step('gifts', _loadGifts);
    await step('cosmetics', _loadCosmetics);
    await step('me', _refreshMe);
    await step('styles', _loadMyStyles);
    await step('friends', _loadFollowers);

    if (!mounted) return;
    setState(() {
      loading = false;
      loadError = errors.join(' | ');
      sbStatus = errors.isEmpty ? 'Supabase Live' : 'Partial (${errors.length} error)';
    });

    _announceMyEntry();
  }

  Future<void> _loadProfile() async {
    final uid = _uid!;
    final row = await _sb
        .from('user_public_profiles')
        .select('username, zoonl_id')
        .eq('user_id', uid)
        .maybeSingle();

    if (row != null && mounted) {
      final nm = (row['username'] ?? '').toString();
      final zid = (row['zoonl_id'] ?? '').toString();
      setState(() {
        if (nm.isNotEmpty) userName = nm;
        if (zid.isNotEmpty) userId = 'ID: $zid';
      });
    }

    try {
      final own = await _sb.rpc('is_zoonl_owner');
      if (mounted) setState(() => isOwner = own == true);
    } catch (_) {
      if (mounted) setState(() => isOwner = false);
    }
  }

  Future<void> _loadLevels() async {
    final rows = await _sb
        .from('wealth_levels')
        .select('level, title, required_exp, tier_name')
        .order('level');
    final titles = <int, String>{};
    for (final row in List<Map<String, dynamic>>.from(rows)) {
      final level = (row['level'] as num?)?.toInt();
      if (level == null) continue;
      final title = (row['title'] ?? '').toString().trim();
      if (title.isNotEmpty) titles[level] = title;
    }
    if (mounted) {
      setState(() => _levelTitles
        ..clear()
        ..addAll(titles));
    }
  }

  Future<void> _loadGifts() async {
    final rows = await _sb
        .from('gifts')
        .select('id, gift_name, image_url, animation_url, animation_3d_url, sound_url, coin_price, diamond_value, category')
        .eq('is_active', true)
        .order('coin_price');
    final list = List<Map<String, dynamic>>.from(rows);
    final out = <_LiveGiftModel>[];
    for (var i = 0; i < list.length; i++) {
      final r = list[i];
      final name = (r['gift_name'] ?? 'Gift').toString();
      final anim3d = (r['animation_3d_url'] ?? '').toString();
      final anim = (r['animation_url'] ?? '').toString();
      final snd = (r['sound_url'] ?? '').toString();
      final pal = _giftPalette[i % _giftPalette.length];
      out.add(
        _LiveGiftModel(
          id: r['id'].toString(),
          name: name,
          coins: (r['coin_price'] as num?)?.toInt() ?? 0,
          diamonds: (r['diamond_value'] as num?)?.toInt() ?? 0,
          category: (r['category'] ?? 'General').toString(),
          art: _artFor(name),
          songLabel: snd.isNotEmpty ? 'Gift Sound' : '',
          videoUrl: anim3d.isNotEmpty ? anim3d : anim,
          imageUrl: (r['image_url'] ?? '').toString(),
          soundUrl: snd,
          c1: pal[0],
          c2: pal[1],
        ),
      );
    }
    if (mounted) setState(() => gifts = out);
  }

  Future<void> _loadCosmetics() async {
    final rows = await _sb
        .from('zoonl_live_cosmetics')
        .select('zoonl_item_code, zoonl_item_name, item_type, media_url, sound_fx, color_theme_hex, gradient_cycle_sec, duration_sec, min_level_req, coin_price, is_active, sort_order')
        .eq('project_name', 'ZOONL LIVE')
        .order('sort_order');
    final list = List<Map<String, dynamic>>.from(rows);
    final out = <_CosmeticModel>[];
    for (final r in list) {
      var cols = _hexList(r['color_theme_hex']?.toString());
      if (cols.isEmpty) cols = [const Color(0xFFFFD700), const Color(0xFF7C4DFF)];
      if (cols.length == 1) cols = [cols.first, cols.first];
      out.add(
        _CosmeticModel(
          code: (r['zoonl_item_code'] ?? '').toString(),
          name: (r['zoonl_item_name'] ?? '').toString(),
          type: (r['item_type'] ?? '').toString(),
          mediaUrl: (r['media_url'] ?? '').toString(),
          soundFx: (r['sound_fx'] ?? '').toString(),
          colors: cols,
          cycleSec: (r['gradient_cycle_sec'] as num?)?.toDouble() ?? 4,
          durationSec: (r['duration_sec'] as num?)?.toInt() ?? 0,
          minLevel: (r['min_level_req'] as num?)?.toInt() ?? 0,
          price: (r['coin_price'] as num?)?.toInt() ?? 0,
          active: r['is_active'] == true,
          sortOrder: (r['sort_order'] as num?)?.toInt() ?? 0,
        ),
      );
    }
    if (!mounted) return;
    setState(() {
      cosmetics = out;
      _rebuildFrames();
    });
  }

  _ProfileFrameModel _frameFrom(_CosmeticModel c) {
    final a = _artFor(c.name);
    return _ProfileFrameModel(
      id: c.code,
      name: c.name,
      crown: c.isOwnerItem ? '👑' : (a == '🎁' ? '✨' : a),
      c1: c.colors.first,
