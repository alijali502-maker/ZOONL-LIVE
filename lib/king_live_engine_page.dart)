List<Color> _hexList(String? raw) {
  final out = <Color>[];
  if (raw == null) return out;
  for (final part in raw.split(',')) {
    var h = part.trim().replaceAll('#', '');
    if (h.length == 6) h = 'FF$h';
    if (h.length != 8) continue;
    final v = int.tryParse(h, radix: 16);
    if (v != null) out.add(Color(v));
  }
  return out;
}

String _artFor(String name) {
  final n = name.toLowerCase();
  if (n.contains('lion') || n.contains('sher') || n.contains('tiger')) return '🦁';
  if (n.contains('palace') || n.contains('castle') || n.contains('mansion') || n.contains('mahal')) return '🏰';
  if (n.contains('ring') || n.contains('proposal') || n.contains('marry')) return '💍';
  if (n.contains('heart') || n.contains('love')) return '💖';
  if (n.contains('rose') || n.contains('flower')) return '🌹';
  if (n.contains('bird') || n.contains('paradise') || n.contains('dove')) return '🕊️';
  if (n.contains('crown') || n.contains('king') || n.contains('royal')) return '👑';
  if (n.contains('diamond') || n.contains('gem')) return '💎';
  if (n.contains('rocket')) return '🚀';
  if (n.contains('yacht') || n.contains('ship') || n.contains('jet')) return '🛥️';
  return '🎁';
}

