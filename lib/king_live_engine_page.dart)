  String _rankTitle(int level) {
    if (level >= 100) return 'SOVEREIGN OWNER';
    return _levelTitles[level] ?? 'LEVEL $level';
  }

  Color _rankColor(int level) {
    if (level >= 100) return const Color(0xFFFFD98B);
    const palette = [
      Color(0xFF90A4AE), Color(0xFF36C9F0), Color(0xFFB69AFF),
      Color(0xFFFFB86B), Color(0xFFFF8FC4), Color(0xFF70F2E8),
      Color(0xFFFF8B83), Color(0xFFFFD76A), Color(0xFFFF9EEB),
      Color(0xFFFFE5A0),
    ];
    final tier = level <= 10 ? level - 1 : ((level - 1) ~/ 10).clamp(1, 9).toInt();
    final base = HSVColor.fromColor(palette[tier]);
    return base.withHue((base.hue + (level % 10) * 3.2) % 360).toColor();
  }

  Future<_Person> _person(String uid) async {
    final cached = _people[uid];
    if (cached != null) return cached;
    var name = uid.length >= 4 ? 'User ${uid.substring(0, 4)}' : 'User';
    var zid = '';
    var level = 1;
    try {
      final r = await _sb.from('user_public_profiles')
          .select('username, zoonl_id').eq('user_id', uid).maybeSingle();
      if (r != null) {
        final n = (r['username'] ?? '').toString();
        if (n.isNotEmpty) name = n;
        zid = (r['zoonl_id'] ?? '').toString();
      }
    } catch (_) {}
    try {
      final value = await _sb.rpc('zoonl_level_for_user', params: {'p_user_id': uid});
      if (value is num) level = value.toInt();
    } catch (_) {}
    var ribbon = _rankColor(level);
    try {
      final r = await _sb.from('zoonl_live_active_styles')
          .select('active_chat_bubble_code').eq('user_id', uid).maybeSingle();
      final c = _cosmeticByCode(r?['active_chat_bubble_code']?.toString());
      if (c != null) ribbon = c.colors.first;
    } catch (_) {}
    final p = _Person(name: name, zid: zid.isEmpty ? 'ID: -' : 'ID: $zid',
      level: level, ribbon: ribbon);
    _people[uid] = p;
    return p;
  }

