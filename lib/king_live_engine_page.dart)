  Widget _buildFramedAvatar(
    _ProfileFrameModel frame, {
    required double size,
    required bool muted,
    String? fallback,
    String? floatingEmoji,
  }) {
    final hasFrame = frame.id != 'none';
    final extra = frame.isOwner ? 8.0 : 0.0;
    final ringColors = frame.colors.length >= 2
        ? [...frame.colors, frame.colors.first]
        : [frame.c1, frame.c2, Colors.white, frame.c1];

    return SizedBox(
      width: size + 12 + extra,
      height: size + 12 + extra,
      child: Stack(
        alignment: Alignment.center,
        clipBehavior: Clip.none,
        children: [
          if (hasFrame)
            RotationTransition(
              turns: _frameAnimCtrl,
              child: Container(
                width: size + 6 + extra,
                height: size + 6 + extra,
                decoration: BoxDecoration(
                  shape: BoxShape.circle,
                  gradient: SweepGradient(colors: ringColors),
                  boxShadow: frame.isOwner
                      ? [BoxShadow(color: frame.c2.withOpacity(0.75), blurRadius: 16, spreadRadius: 1)]
                      : null,
                ),
              ),
            ),
          CircleAvatar(
            radius: size / 2,
            backgroundColor: const Color(0xFF1A2234),
            child: fallback != null
                ? Text(fallback, style: TextStyle(fontSize: size * 0.36, fontWeight: FontWeight.bold))
                : Icon(muted ? Icons.mic_off : Icons.person, size: size * 0.48),
          ),
          if (hasFrame && frame.crown.isNotEmpty)
            Positioned(
              top: -2,
              child: Text(frame.crown, style: TextStyle(fontSize: size * (frame.isOwner ? 0.42 : 0.3))),
            ),
          if (floatingEmoji != null)
            Positioned(
              right: -4,
              top: -6,
              child: AnimatedBuilder(
                animation: _emojiAnimCtrl,
                builder: (ctx, child) => Transform.translate(
                  offset: Offset(0, -_emojiAnimCtrl.value * 5),
                  child: child,
                ),
                child: Container(
                  padding: const EdgeInsets.all(2),
                  decoration: BoxDecoration(
                    color: Colors.black87,
                    shape: BoxShape.circle,
                    border: Border.all(color: Colors.amberAccent, width: 1),
                  ),
                  child: Text(floatingEmoji, style: TextStyle(fontSize: size * 0.36)),
                ),
              ),
            ),
        ],
      ),
    );
  }
