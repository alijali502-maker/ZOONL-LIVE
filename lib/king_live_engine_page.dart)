  Future<void> _sendGift(_LiveGiftModel gift) async {
    final rid = widget.roomId;
    if (rid == null) {
      _snack('Gift bhejne ke liye pehle kisi live room me jaiye.');
      return;
    }
    if (_uid == null) {
      _snack('Pehle login karein.');
      return;
    }
    if (_sendingGift) return;
    if (coins < gift.coins) {
      _snack('Coins kam hain! Store/Wallet se coins lein.');
      return;
    }

    _sendingGift = true;
    final beforeLv = myLevel;
    try {
      // Coins katna, host ko diamonds, record: sab database function karta hai.
      await _sb.rpc('send_live_gift', params: {
        'p_gift_id': gift.id,
        'p_room_id': rid,
        'p_quantity': 1,
      });

      if (!mounted) return;
      setState(() {
        topGifters[userName] = (topGifters[userName] ?? 0) + gift.coins;
        if (pkRunning) myPkScore += gift.coins;
        chatList.add(
          _ChatRibbonMsg(
            sender: userName,
            userId: userId,
            text: 'Sent ${gift.art} ${gift.name} (${gift.coins} coins)',
            level: myLevel,
            ribbonColor: gift.c1,
          ),
        );
      });

      _playGift(gift, '$userName ($userId)');
      await _refreshMe();

      if (mounted && myLevel > beforeLv) {
        final t = currentLevelTier;
        _snack('🎉 Level Up! Ab Level ${t.level} (${t.title})', color: t.pattiStart);
      }
    } catch (e) {
      _snack(_mapErr(e));
    } finally {
      _sendingGift = false;
    }
  }

  Future<void> _playGift(_LiveGiftModel gift, String sender) async {
    if (!mounted) return;
    if (activeGift != null) {
      _giftQueue.add(_QueuedGift(gift, sender));
      return;
    }

    setState(() {
      activeGift = gift;
      activeGiftSender = sender;
    });

    var dur = const Duration(milliseconds: 3600);

    if (gift.hasVideo) {
      try {
        final c = VideoPlayerController.networkUrl(Uri.parse(gift.videoUrl));
        _giftVideo = c;
        await c.initialize();
        await c.setLooping(false);
        await c.play();
        final d = c.value.duration;
        if (d > Duration.zero) {
          dur = d > const Duration(seconds: 12) ? const Duration(seconds: 12) : d;
        }
        if (mounted) setState(() {});
      } catch (_) {
        final bad = _giftVideo;
        _giftVideo = null;
        bad?.dispose();
      }
    }

    unawaited(_playGiftSound(gift));

    if (!mounted) return;
    _giftAnimCtrl.duration = dur;
    _giftAnimCtrl.forward(from: 0).then((_) {
      if (!mounted) return;
      final v = _giftVideo;
      _giftVideo = null;
      setState(() => activeGift = null);
      Future.delayed(const Duration(milliseconds: 250), () => v?.dispose());
      if (_giftQueue.isNotEmpty) {
        final next = _giftQueue.removeAt(0);
        _playGift(next.gift, next.sender);
      }
    });
  }

  Future<void> _playGiftSound(_LiveGiftModel g) async {
    if (!autoSoundEnabled) return;
    if (g.soundUrl.isNotEmpty) {
      try {
        _giftAudio ??= AudioPlayer();
        await _giftAudio!.setUrl(g.soundUrl);
        unawaited(_giftAudio!.play());
        return;
      } catch (_) {}
    }
    await _playSound();
  }

