  String _mapErr(Object e) {
    final raw = e is PostgrestException ? e.message : e.toString();
    const map = {
      'LOGIN_REQUIRED': 'Pehle login karein.',
      'INSUFFICIENT_COINS': 'Coins kam hain!',
      'ROOM_NOT_LIVE': 'Yeh live khatam ho chuka hai.',
      'ROOM_NOT_FOUND': 'Room nahi mila.',
      'CANNOT_SEND_GIFT_TO_SELF': 'Apne hi room me gift nahi bhej sakte.',
      'ROOM_ACCESS_REQUIRED': 'Is private room me aapko access nahi hai.',
      'GIFT_NOT_AVAILABLE': 'Yeh gift ab available nahi hai.',
      'ITEM_NOT_AVAILABLE': 'Yeh item available nahi hai.',
      'OWNER_ONLY_ITEM': 'Yeh item sirf Owner ke liye hai.',
      'OWNER_ONLY': 'Yeh kaam sirf Owner kar sakta hai.',
      'LEVEL_TOO_LOW': 'Aapka level abhi kam hai.',
      'ALREADY_OWNED': 'Yeh item aapke paas pehle se hai.',
      'ITEM_NOT_OWNED_OR_EXPIRED': 'Yeh item aapke paas nahi hai.',
    };
    for (final k in map.keys) {
      if (raw.contains(k)) return map[k]!;
    }
    return raw;
  }

  void _snack(String text, {Color? color}) {
