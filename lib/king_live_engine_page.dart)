  Future<void> _sendColorRibbonChat() async {
    final txt = chatInputCtrl.text.trim();
    if (txt.isEmpty) return;
    final rid = widget.roomId;
    final uid = _uid;
    if (rid == null || uid == null) {
      _snack('Chat ke liye login karke kisi live room me jaiye.');
      return;
    }
    chatInputCtrl.clear();
    try {
      final row = await _sb
          .from('chat_messages')
          .insert({'room_id': rid, 'sender_id': uid, 'message': txt})
          .select('id')
          .single();
      final id = row['id'].toString();
      if (_seenChat.add(id) && mounted) {
        setState(() {
          chatList.add(
            _ChatRibbonMsg(
              sender: userName,
              userId: userId,
              text: txt,
              level: currentLevelTier.level,
              ribbonColor: selectedChatRibbonColor,
            ),
          );
        });
      }
    } catch (e) {
      _snack('Message nahi gaya: ${_mapErr(e)}');
    }
  }

  void _applySeatEmoji(String em) {
    setState(() {
      if (selectedEmojiSeat == 0) {
        hostEmoji = em;
        hostEmojiTimer?.cancel();
        hostEmojiTimer = Timer(const Duration(seconds: 5), () {
          if (mounted) setState(() => hostEmoji = null);
        });
      } else {
        final s = seats.firstWhere((item) => item.seatNo == selectedEmojiSeat, orElse: () => seats.first);
        if (!s.occupied) {
          s.userName = 'Seat ${s.seatNo}';
          s.userId = 'ID: 20${s.seatNo}55';
        }
        s.emoji = em;
        s.emojiTimer?.cancel();
        s.emojiTimer = Timer(const Duration(seconds: 5), () {
          if (mounted) setState(() => s.emoji = null);
        });
      }
    });
    _playSound();
  }

