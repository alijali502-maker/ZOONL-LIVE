  Widget _buildGiftArt(_LiveGiftModel g) {
    final vc = _giftVideo;
    if (g.hasVideo && vc != null && vc.value.isInitialized) {
      return SizedBox(
        height: 260,
        child: AspectRatio(
          aspectRatio: vc.value.aspectRatio,
          child: VideoPlayer(vc),
        ),
      );
    }
    if (g.hasAnimatedImage) {
      return SizedBox(
        height: 220,
        child: Image.network(
          g.videoUrl,
          fit: BoxFit.contain,
          errorBuilder: (ctx, err, st) => Text(g.art, style: const TextStyle(fontSize: 42)),
        ),
      );
    }
    if (g.imageUrl.isNotEmpty) {
      return SizedBox(
        height: 140,
        child: Image.network(
          g.imageUrl,
          fit: BoxFit.contain,
          errorBuilder: (ctx, err, st) => Text(g.art, style: const TextStyle(fontSize: 42)),
        ),
      );
    }
    return Text(g.art, style: const TextStyle(fontSize: 42));
  }

