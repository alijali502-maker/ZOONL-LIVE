class _LiveGiftModel {
  final String id;
  String name;
  int coins;
  int diamonds;
  String category;
  String art;
  String songLabel;
  String videoUrl; // 3D / video / animated image link (animation_3d_url)
  String imageUrl;
  String soundUrl;
  Color c1;
  Color c2;

  _LiveGiftModel({
    required this.id,
    required this.name,
    required this.coins,
    this.diamonds = 0,
    required this.category,
    required this.art,
    required this.songLabel,
    this.videoUrl = '',
    this.imageUrl = '',
    this.soundUrl = '',
    required this.c1,
    required this.c2,
  });

  static bool _isVideoUrl(String url) {
    final l = url.toLowerCase().split('?').first;
    return l.endsWith('.mp4') ||
        l.endsWith('.webm') ||
        l.endsWith('.mov') ||
        l.endsWith('.m4v');
  }

  bool get hasVideo => videoUrl.isNotEmpty && _isVideoUrl(videoUrl);
  bool get hasAnimatedImage => videoUrl.isNotEmpty && !_isVideoUrl(videoUrl);

  Map<String, dynamic> toJson() => {
        'id': id,
        'name': name,
        'coins': coins,
        'diamonds': diamonds,
        'category': category,
        'art': art,
        'songLabel': songLabel,
        'videoUrl': videoUrl,
        'imageUrl': imageUrl,
        'soundUrl': soundUrl,
        'c1': c1.value,
        'c2': c2.value,
      };
}

